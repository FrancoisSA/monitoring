# Configuration Hermes Agent via Mammouth AI
# Note : pas de commentaires en fin de ligne — systemd EnvironmentFile ne les
# supprime pas (le code les tolère, mais restons propres).

# Clé API Mammouth AI (obtenir sur https://mammouth.ai/app/account/settings/api)
MAMMOUTH_API_KEY=

# Modèle Mammouth AI (alias : mammouth, recommended, mammouth-recommended)
MAMMOUTH_MODEL=mammouth-recommended

# Créativité (0.0 = déterministe, 2.0 = très créatif)
TEMPERATURE=0.7

# Tokens maximum par réponse
MAX_TOKENS=4096

# Timeout pour les appels API en secondes (Mammouth peut être lent)
API_TIMEOUT=120

# Langue par défaut
LANGUAGE=fr
