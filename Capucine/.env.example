# Capucine — configuration
# Copier vers .env puis renseigner les valeurs.

# Token du bot Telegram Capucine (obtenir/gérer via @BotFather > /mybots > API Token)
TELEGRAM_BOT_TOKEN=

# chat_id autorisé à utiliser le bot — whitelist stricte, tout autre expéditeur est ignoré
TELEGRAM_CHAT_ID=

# Hôte de l'API Ollama locale
OLLAMA_HOST=http://127.0.0.1:11434

# Modèle Ollama utilisé par défaut par les agents "légers"
OLLAMA_MODEL=qwen2.5:3b

# Timeout (secondes) des appels à Ollama — prévoir une marge pour le cold
# start (modèle non chargé en mémoire, mesuré à ~14s sur le Pi pour une
# réponse courte)
OLLAMA_TIMEOUT=60

# Chemin du fichier SQLite (historique + journal de performance)
CAPUCINE_DB_PATH=capucine.db

# Flux RSS suivis par /presse (revue de presse), séparés par des virgules.
# Vide = valeurs par défaut (Automobile Propre, Electrek, InsideEVs, CleanTechnica).
PRESSE_FEEDS=

# Socket Unix local par lequel cron déclenche un agent planifié (ex. /presse
# chaque matin) sans relancer tout le service — cf. scripts/trigger.sh.
CAPUCINE_SOCKET_PATH=/tmp/capucine.sock

# Timeout (secondes) spécifique aux appels Ollama de /presse — un prompt de
# plusieurs articles prend nettement plus longtemps à traiter par le modèle
# local que les autres agents (mesuré ~3-4 min sur un Pi 5 pour 15 articles).
PRESSE_LLM_TIMEOUT=420

# Requêtes de veille pour /renault (recherche Google News), séparées par des
# virgules. Vide = valeurs par défaut (Renault véhicules électriques, "Renault Ampere").
RENAULT_SEARCH_QUERIES=

# Timeout (secondes) spécifique aux appels Ollama de /renault — même pipeline
# que /presse (traduction/résumé de plusieurs articles).
RENAULT_LLM_TIMEOUT=420

# Flux RSS pour /ia (digest IA & frameworks agentiques), séparés par des
# virgules. Vide = valeurs par défaut (Simon Willison, Hugging Face, OpenAI News, Interconnects).
IA_FEEDS=

# Timeout (secondes) spécifique aux appels Ollama de /ia — même pipeline que
# /presse (traduction/résumé de plusieurs articles).
IA_LLM_TIMEOUT=420

# --- Intégration Mac + LM Studio (texte + vocal), pour /presse /renault /ia ---
# MAC_HOST vide = intégration désactivée, agents en Ollama uniquement (comportement
# d'origine). Toutes les variables ci-dessous sont ignorées dans ce cas.

# Adresse IP ou nom d'hôte du Mac sur le réseau local (ex. 10.0.0.8)
MAC_HOST=

# Utilisateur SSH sur le Mac
MAC_SSH_USER=

# Clé SSH dédiée à la connexion Pi -> Mac (différente de la clé utilisée pour
# les déploiements Mac -> Pi : le Pi n'a pas de copie de cette dernière, et ne
# doit pas en avoir — clé générée sur le Pi, sa partie publique est ajoutée
# au ~/.ssh/authorized_keys du Mac par le wizard)
MAC_SSH_KEY_PATH=/home/fsalazar/.ssh/capucine_mac_ed25519

# Adresse MAC (physique, format AA:BB:CC:DD:EE:FF) de l'interface réseau du
# Mac, nécessaire pour le paquet magique Wake-on-LAN
MAC_ADDRESS=

# Modèle LM Studio à utiliser — qwen3.5-9b-mlx (reasoning) a été écarté car il
# consomme tous ses tokens en réflexion cachée sans jamais produire de réponse
# sur ce type de prompt ; qwen3-coder-30b-a3b-instruct-mlx a été vérifié
# fonctionnel (~14s, zéro token de réflexion) malgré son nom "coder".
MAC_MODEL=qwen3-coder-30b-a3b-instruct-mlx

# Budget total (secondes) d'attente du réveil du Mac (Wake-on-LAN + démarrage
# + chargement du modèle) avant de basculer sur Ollama local
MAC_WAKE_TIMEOUT_S=180

# Intervalle (secondes) entre deux tentatives de reconnexion SSH pendant l'attente
MAC_RETRY_INTERVAL_S=10

# Chemin absolu, sur le Mac, du modèle Qwen3-TTS MLX local utilisé pour le
# TTS des digests (/presse, /renault, /ia), cf.
# scripts/mac_qwen_tts_to_ogg.sh (exécuté via `uvx --from mlx-audio`).
# Remplace l'ancien pipeline `say` (voix macOS), jugé nettement moins
# naturel à l'écoute (décision du 2026-09-27). Le modèle doit déjà être
# téléchargé sur le Mac (visible via `lms ls`) ; aucun téléchargement n'est
# déclenché automatiquement par ce script.
CAPUCINE_TTS_MODEL_PATH=/Users/francoissalazar/Documents/09-LOCAL/13-PROJECTS/02-MODELS/hub/mlx-community/Qwen3-TTS-12Hz-1.7B-Base-bf16

# --- Intégration Google Calendar/Gmail, pour /agenda et /agenda_check (tool-calling via Ollama) ---

# Fichier de client secret OAuth (téléchargé depuis Google Cloud Console).
# Ne jamais committer ce fichier — cf. .gitignore.
GOOGLE_CREDENTIALS_FILE=credentials.json

# Fichier de token OAuth persistant, généré à la première authentification
# (cf. USERGUIDE — étape manuelle sur une machine avec navigateur, puis
# copié sur le Pi). Ne jamais committer ce fichier — cf. .gitignore.
GOOGLE_TOKEN_FILE=token.json

# Fuseau horaire de référence pour les événements calendrier
CALENDAR_TIMEZONE=Europe/Paris

# Nom du calendrier Google cible pour les événements [AGENDA PRO]
CALENDAR_AGENDA_PRO_NAME=Ampere

# Calendriers additionnels à afficher dans le dashboard (/api/events),
# séparés par des virgules — typiquement un calendrier d'un autre compte
# Google partagé en lecture avec le compte authentifié (Paramètres > Partager
# avec des personnes précises, sur le compte source). Utiliser le nom exact
# tel qu'il apparaît dans la liste des calendriers une fois le partage fait
# (souvent l'adresse email du compte source, ex. humancomedie.31@gmail.com).
# Vide = seul le calendrier "primary" est interrogé.
EXTRA_CALENDAR_NAMES=

# Délai (minutes) avant un événement pour envoyer un rappel Telegram. Doit
# rester >= 2x l'intervalle du cron qui déclenche /agenda_check (10 min par
# défaut, cf. crontab) pour ne rater aucun événement entre deux vérifications.
CALENDAR_REMINDER_ADVANCE_MINUTES=20

# Modèle Ollama dédié au tool-calling de /agenda (parsing du langage
# naturel via l'API /api/chat d'Ollama). Vide = même modèle que OLLAMA_MODEL.
# À surveiller : un petit modèle (ex. qwen2.5:3b) peut être peu fiable pour
# décider quel outil calendrier appeler — pointer vers un modèle plus gros
# ici si besoin, sans toucher au code.
AGENDA_OLLAMA_MODEL=

# Timeout (secondes) des appels /api/chat pour /agenda
AGENDA_LLM_TIMEOUT=60

# --- Dashboard web (tâches, agenda, weekends) — capucine/dashboard.py ---
# Pas de login applicatif : accès protégé uniquement par le réseau
# (LAN/Tailscale de confiance), même posture que Pi Monitor sur ce Pi.

# Port HTTP du dashboard (9090 = Pi Monitor, 9191 = Jeffrey sur ce même Pi)
DASHBOARD_PORT=9192

# URL de callback OAuth du dashboard — DOIT correspondre exactement à
# l'adresse que votre navigateur utilise pour atteindre le Pi (pas
# "localhost" si vous vous connectez depuis un autre appareil), ex.
# http://FSA-PI5.local:9192/auth/callback ou l'IP Tailscale du Pi. Doit
# aussi être enregistrée telle quelle dans les "URI de redirection
# autorisés" du client OAuth Google Cloud Console. Ce client doit être de
# type "Application Web" (pas "Application de bureau") pour que ce flux
# navigateur fonctionne — contrairement à l'auth manuelle de secours des
# jobs de fond (/agenda_check), qui tolère les deux types.
OAUTH_REDIRECT_URI=http://localhost:9192/auth/callback

# Durée de vie (secondes) du cache mémoire des appels Google Calendar/Tasks
# (cf. capucine/cache.py). Réduit le temps de chargement des pages (chaque
# appel Google prend ~0.5-0.75s) sans trop retarder la prise en compte d'une
# modification faite depuis Google Calendar/Tasks directement (hors dashboard).
DASHBOARD_CACHE_TTL_SECONDS=30
